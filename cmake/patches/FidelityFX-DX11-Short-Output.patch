+	# FidelityFX_SC uses a fixed-size native buffer for its output argument and
+	# crashes after compiling when an absolute Windows build path is long. Keep
+	# the compiler and MSVC's generated-header include lookup on short paths.
+	if(PIXL_FFX_SHORT_BINARY_ROOT)
+		set(SC_WORKING_DIRECTORY ${PIXL_FFX_SHORT_BINARY_ROOT})
+		set(SC_OUTPUT_PATH ffx-dx11-shaders)
